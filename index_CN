        document.body.appendChild(modal);
        
        document.getElementById('startTaskBtn').onclick = () => {
            modal.remove();
            startMainTask();
        };
    }
    
    function startMainTask() {
        const hasPrev = loadFromLocal();
        if (hasPrev && ratingsData.length) {
            const confirmResume = confirm(`检测到之前的进度（已完成 ${ratingsData.length}/${TOTAL_CLIPS} 段），是否继续？`);
            if (!confirmResume) {
                ratingsData = [];
                currentIndex = 0;
                currentScores = { valence: null, arousal: null, confidence: null };
                localStorage.removeItem(getStorageKey());
            }
        }
        if (currentIndex >= TOTAL_CLIPS) currentIndex = TOTAL_CLIPS - 1;
        if (ratingsData.length >= TOTAL_CLIPS) isCompleted = true;
        
        mainApp.style.display = 'block';
        buildButtons();
        loadClip(currentIndex);
        updateTableDisplay();
        
        submitBtn.onclick = submitRating;
        resetBtn.onclick = () => { currentScores = { valence: null, arousal: null, confidence: null }; updateButtonsUI(); saveToLocal(); };
        exportBtn.onclick = manualExport;
    }
    
    showConsentAndTutorial();
</script>
