                        <option value="Yes">看过</option>
                        <option value="No">没看过</option>
                        <option value="Not sure">不确定</option>
                    </select>
                </div>
                
                <div class="check-group">
                    <input type="checkbox" id="consentCheckbox">
                    <label>我同意参与本研究</label>
                </div>
                
                <button id="nextToTutorialBtn" class="btn-primary" style="width:100%; margin-top:20px;">📖 下一步：教程 →</button>
            </div>
        `;
        document.body.appendChild(modal);
        
        document.getElementById('nextToTutorialBtn').onclick = async () => {
            const subjectId = document.getElementById('consentSubjectId').value.trim();
            const age = document.getElementById('participantAge').value.trim();
            const gender = document.getElementById('participantGender').value;
            const nativeEnglish = document.getElementById('nativeEnglish').value;
            const seenMovie = document.getElementById('seenMovie').value;
            const consented = document.getElementById('consentCheckbox').checked;
            
            if (!subjectId) { alert('请输入被试ID'); return; }
            if (!age) { alert('请输入年龄'); return; }
            if (!gender) { alert('请选择性别'); return; }
            if (!nativeEnglish) { alert('请选择是否为英语母语者'); return; }
            if (!seenMovie) { alert('请选择是否看过《回到未来》'); return; }
            if (!consented) { alert('请勾选知情同意'); return; }
            
            currentSubjectId = subjectId;
            
            window.participantInfo = {
                age: age,
                gender: gender,
                nativeEnglish: nativeEnglish,
                seenMovie: seenMovie
            };
            
            modal.remove();
            
            await loadVideoList();
            showTutorial();
        };
    }
    
    function showTutorial() {
        const modal = document.createElement('div');
        modal.className = 'modal-overlay';
        modal.innerHTML = `
            <div class="modal-card">
                <h2>📖 评分教程</h2>
                
                <div class="tutorial-step">
                    <div style="font-weight:bold; color:#a29bfe;">😊 情绪效价</div>
                    <p>这个片段让你感觉积极/愉悦还是消极/难受？<br>📊 -5(非常消极) → 0(中性) → +5(非常积极)</p>
                </div>
                <div class="tutorial-step">
                    <div style="font-weight:bold; color:#a29bfe;">⚡ 情绪唤醒度</div>
